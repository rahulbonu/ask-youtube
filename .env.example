# ---------------------------------------------------------------------------
# Answer generation. Pick ONE provider and set its key.
# ---------------------------------------------------------------------------

# Default provider. One of: anthropic | huggingface
YTRAG_LLM_PROVIDER=anthropic

# provider=anthropic  (recommended - works out of the box, no gated models)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5-5
# YTRAG_ANTHROPIC_MODEL=claude-opus-5-5

# provider=huggingface
# Note: most instruct models on the HF serverless API are gated and require
# you to accept their licence on huggingface.co first.
# HF_TOKEN=hf_...
# YTRAG_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Local embedding model (downloaded once, then cached by sentence-transformers)
# YTRAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Where to cache built indexes. Defaults to ./.cache/ytrag
# YTRAG_CACHE_DIR=.cache/ytrag

# Preferred transcript languages, most preferred first
# YTRAG_LANGUAGES=en,hi

# Retrieval
# YTRAG_TOP_K=5
# YTRAG_CHUNK_CHARS=1000
# YTRAG_CHUNK_OVERLAP_CHARS=200

# Rewrite follow-up questions into standalone queries before retrieving
# YTRAG_CONDENSE_QUESTION=true

# YouTube blocks many datacentre IPs. Route transcript fetches through a proxy
# if you deploy to a cloud host and see "no transcript" errors.
# YTRAG_YOUTUBE_PROXY=http://user:pass@host:port
